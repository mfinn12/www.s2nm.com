---
// Small monospace section label, e.g. "// Functional expertise".
// Pass as="h2" when the label is the section's only heading.
interface Props {
  as?: 'p' | 'h2';
  class?: string;
}
const { as: Tag = 'p', class: className = '' } = Astro.props;
---

<Tag class:list={['font-mono text-[13px] font-normal text-subtle', className]}><span aria-hidden="true">// </span><slot /></Tag>
