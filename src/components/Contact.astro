---
import { site, socials } from '../data/site';

const linkedin = socials.find((s) => s.label === 'LinkedIn');
---

<section id="contact" class="scroll-mt-20 px-4 py-20 sm:px-8 sm:py-28">
  <div
    class="mx-auto grid max-w-6xl gap-10 rounded-3xl border border-line-strong bg-panel p-8 sm:p-14 md:grid-cols-2 md:items-center md:gap-16"
  >
    <div>
      <h2 class="font-display text-4xl font-semibold tracking-[-0.03em] sm:text-5xl">Get started now</h2>
      <p class="mt-5 text-lg leading-relaxed text-muted">
        Ready to solidify your marketing strategy and grow your business? Send us an email and we'll be back to you
        shortly to schedule a conversation.
      </p>
    </div>
    <div class="flex flex-col gap-4 md:items-start">
      <a
        href={`mailto:${site.email}?subject=${encodeURIComponent('Contact Us')}`}
        class="inline-flex min-h-13 items-center justify-center rounded-lg bg-accent px-6 font-semibold text-ink transition-colors hover:bg-accent-hover focus-visible:ring-2 focus-visible:ring-accent/50 focus-visible:outline-none"
      >
        Email {site.email} →
      </a>
      {
        linkedin && (
          <a
            href={linkedin.href}
            rel="noopener"
            class="inline-flex min-h-13 items-center justify-center rounded-lg border border-line-strong px-6 font-medium transition-colors hover:border-subtle"
          >
            Message us on LinkedIn
          </a>
        )
      }
    </div>
  </div>
</section>
