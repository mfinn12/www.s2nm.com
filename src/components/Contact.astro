---
import { site } from '../data/site';

const field =
  'mt-2 h-12 w-full rounded-lg border border-line-strong bg-ink px-4 text-base text-fg placeholder:text-dim focus:border-accent focus:ring-2 focus:ring-accent/40 focus:outline-none';
---

<section id="contact" class="scroll-mt-20 px-4 py-20 sm:px-8 sm:py-28">
  <div
    class="mx-auto grid max-w-6xl gap-10 rounded-3xl border border-line-strong bg-panel p-8 sm:p-14 md:grid-cols-2 md:gap-16"
  >
    <div>
      <h2 class="font-display text-4xl font-semibold tracking-[-0.03em] sm:text-5xl">Get started now</h2>
      <p class="mt-5 text-lg leading-relaxed text-muted">
        Ready to solidify your marketing strategy and grow your business? Enter your name and business email address
        and we'll be back to you shortly to schedule a conversation.
      </p>
    </div>
    <form action={site.formAction} method="POST" class="flex flex-col gap-5">
      <input type="hidden" name="_subject" value="Contact Us" />
      <input type="hidden" name="_next" value={new URL('/thank-you/', Astro.site).href} />
      <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />
      <label class="block text-sm text-muted">
        First and last name
        <input name="name" required autocomplete="name" class={field} />
      </label>
      <label class="block text-sm text-muted">
        Business email address
        <input type="email" name="_replyto" required autocomplete="email" class={field} />
      </label>
      <button
        type="submit"
        class="min-h-13 rounded-lg bg-accent px-6 font-semibold text-ink transition-colors hover:bg-accent-hover focus-visible:ring-2 focus-visible:ring-accent/50 focus-visible:outline-none"
      >
        Contact us →
      </button>
    </form>
  </div>
</section>
