---
import { nav } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
// "Home" is the wordmark, so the inline menu lists the other pages.
const links = nav.filter((l) => l.href !== '/');
---

<header class="sticky top-0 z-20 border-b border-line bg-ink/85 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-8">
    <a href="/" class="font-display text-xl font-bold tracking-tight text-fg">
      signal <span class="text-accent">|</span> noise
    </a>

    <ul class="hidden items-center gap-7 text-[15px] sm:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
              class="text-muted transition-colors hover:text-fg aria-[current=page]:text-fg"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="/#contact"
          class="inline-flex min-h-11 items-center rounded-lg bg-accent px-5 font-semibold text-ink transition-colors hover:bg-accent-hover"
        >
          Book a call
        </a>
      </li>
    </ul>

    <details class="relative sm:hidden">
      <summary
        class="flex min-h-11 cursor-pointer list-none items-center rounded-lg border border-line-strong px-4 text-sm font-medium [&::-webkit-details-marker]:hidden"
      >
        Menu
      </summary>
      <ul class="absolute right-0 mt-2 w-48 rounded-xl border border-line-strong bg-panel p-2 shadow-2xl">
        {
          [...nav, { label: 'Book a call', href: '/#contact' }].map((link) => (
            <li>
              <a href={link.href} class="block rounded-lg px-3 py-2.5 text-sm text-muted hover:bg-ink hover:text-fg">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </nav>
</header>

<script>
  // Close the mobile menu after picking a link, on Escape, or on a tap outside it.
  const menu = document.querySelector<HTMLDetailsElement>('header details');
  if (menu) {
    const close = () => menu.removeAttribute('open');
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        close();
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) close();
    });
  }
</script>
