---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Contact from '../components/Contact.astro';
import { portfolio } from '../data/site';
---

<BaseLayout title="Portfolio" description="Examples of B2B marketing work across brand, campaigns, content, demand and more.">
  <PageHeader title="Portfolio" label="Selected work" intro="Selected work across the marketing mix. Examples coming soon." />

  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-8">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        portfolio.map((p) => (
          <li class="flex items-center justify-between gap-4 rounded-2xl border border-line bg-panel px-7 py-6">
            <h2 class="font-display text-lg font-semibold">{p}</h2>
            <span class="font-mono text-xs text-subtle">Soon</span>
          </li>
        ))
      }
    </ul>
  </section>

  <Contact />
</BaseLayout>
