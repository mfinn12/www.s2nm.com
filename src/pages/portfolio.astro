---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Contact from '../components/Contact.astro';
import { portfolio } from '../data/site';
---

<BaseLayout title="Portfolio" description="Examples of B2B marketing work across brand, campaigns, content, demand and more.">
  <PageHeader title="Portfolio" intro="Selected work across the marketing mix. Examples coming soon." />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        portfolio.map((p) => (
          <li class="rounded-xl border border-slate-200 p-6 dark:border-slate-800">
            <h2 class="font-display text-lg font-semibold">{p}</h2>
          </li>
        ))
      }
    </ul>
  </section>

  <Contact />
</BaseLayout>
