---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout title="Page not found" noindex>
  <PageHeader title="Page not found" label="Error 404" intro="That page doesn't exist. It may have moved when the site was rebuilt." />
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-8">
    <a href="/" class="text-accent underline underline-offset-4 hover:text-accent-hover">Go to the home page</a>
  </section>
</BaseLayout>
