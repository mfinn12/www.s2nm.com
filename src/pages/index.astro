---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../components/Contact.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { clients, expertise, funnelStages, metrics, principal, site } from '../data/site';

const [headStart, headEnd] = site.headline.split(', ');
---

<BaseLayout>
  <section class="mx-auto max-w-6xl px-4 pt-24 pb-24 sm:px-8 sm:pt-32 sm:pb-28">
    <p
      class="inline-flex items-center gap-2.5 rounded-full border border-line-strong px-3.5 py-2 font-mono text-[13px] text-muted"
    >
      <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
      B2B marketing advisory · technology companies
    </p>
    <h1
      class="mt-10 max-w-5xl font-display text-6xl leading-[0.95] font-semibold tracking-[-0.04em] sm:text-8xl lg:text-[8.25rem]"
    >
      {headStart},<br /><span class="text-dim">{headEnd.toLowerCase()}.</span>
    </h1>
    <p class="mt-10 max-w-2xl text-xl leading-relaxed text-muted">{site.description}</p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="#contact"
        class="inline-flex min-h-13 items-center rounded-[10px] bg-accent px-7 font-semibold text-ink transition-colors hover:bg-accent-hover"
      >
        Get started →
      </a>
      <a
        href="/expertise/"
        class="inline-flex min-h-13 items-center rounded-[10px] border border-line-strong px-7 font-medium transition-colors hover:border-subtle"
      >
        See expertise
      </a>
    </div>
  </section>

  <section class="border-y border-line bg-ink-raised">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-8 sm:py-20">
      <Eyebrow>Trusted by technology startup leaders</Eyebrow>
      <ul class="mt-8 grid gap-4 md:grid-cols-3">
        {
          clients.map((c) => (
            <li class="flex flex-col gap-3 rounded-2xl border border-line bg-panel p-7">
              <h2 class="font-display text-xl font-semibold">{c.name}</h2>
              <p class="text-[15px] leading-relaxed text-muted">{c.text}</p>
              {c.note && (
                <p class="mt-auto self-start rounded-full bg-accent/15 px-3 py-1 font-mono text-xs text-accent">{c.note}</p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-24 sm:px-8 sm:pt-28">
    <Eyebrow>Full-funnel activities</Eyebrow>
    <h2 class="mt-4 font-display text-4xl leading-tight font-semibold tracking-[-0.03em] sm:text-5xl">
      From first impression to renewal.
    </h2>
    <ol class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {
        funnelStages.map((stage, i) => (
          <li class="bg-ink p-7">
            <p class="font-mono text-xs text-accent">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-3 font-display text-xl font-semibold">{stage}</h3>
            <p class="mt-3 text-sm leading-relaxed text-subtle">{metrics[i].join(' · ')}</p>
          </li>
        ))
      }
    </ol>
    <a href="/activities/" class="mt-6 inline-block text-[15px] text-accent hover:text-accent-hover">
      See every activity by stage →
    </a>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-8 sm:py-28">
    <Eyebrow>Functional expertise</Eyebrow>
    <ul class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        expertise.map((e) => (
          <li class="rounded-2xl border border-line px-7 py-6">
            <h3 class="font-display text-lg font-semibold">{e.area}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">{e.items.join(', ')}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="border-t border-line">
    <div class="mx-auto flex max-w-6xl flex-col gap-12 px-4 py-24 sm:px-8 sm:py-28 md:flex-row md:items-center md:gap-14">
      <img
        src={principal.photo}
        alt={principal.name}
        width="380"
        height="380"
        class="aspect-square w-full max-w-sm shrink-0 rounded-[20px] object-cover grayscale contrast-105"
        loading="lazy"
      />
      <div class="min-w-0">
        <Eyebrow>{principal.role}</Eyebrow>
        <h2 class="mt-4 font-display text-4xl font-semibold tracking-[-0.03em] sm:text-5xl">{principal.name}</h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
          Michael is a technology enthusiast with over 20 years of relevant marketing experience. He leverages his
          deep{' '}<a href="/expertise/" class="text-accent underline-offset-4 hover:underline">functional expertise</a>{' '}to
          drive tactical{' '}<a href="/activities/" class="text-accent underline-offset-4 hover:underline">marketing activities</a>{' '}that
          grow your business.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-2.5">
          <span class="mr-1.5 font-mono text-xs text-subtle">PREVIOUSLY</span>
          {
            principal.employers.map((e) => (
              <span class="rounded-lg border border-line-strong px-3.5 py-2 text-sm font-medium">{e}</span>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Contact />
</BaseLayout>
