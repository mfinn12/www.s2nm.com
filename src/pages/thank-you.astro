---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout title="Thank you" noindex>
  <PageHeader title="Thank you" intro="Thank you for contacting us; we'll be in touch with you soon." />
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-8">
    <p class="text-muted">If you'd like to learn more about us in the meantime, please:</p>
    <ul class="mt-4 list-disc space-y-1 pl-6">
      <li><a href="/expertise/" class="text-accent underline underline-offset-4 hover:text-accent-hover">Read about our expertise</a></li>
      <li><a href="/activities/" class="text-accent underline underline-offset-4 hover:text-accent-hover">See the activities we run</a></li>
      <li><a href="https://www.linkedin.com/company/signal-noise-marketing/" class="text-accent underline underline-offset-4 hover:text-accent-hover">Follow us on LinkedIn</a></li>
    </ul>
  </section>
</BaseLayout>
