---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Contact from '../components/Contact.astro';
import { activities, funnelStages, metrics, strategy } from '../data/site';

const cell = 'border-t border-line p-4 align-top';
---

<BaseLayout title="Activities" description="Tactical B2B marketing activities aligned to each stage of the demand funnel.">
  <PageHeader
    title="Activities"
    label="Full-funnel activities"
    intro="At signal | noise marketing, we think of each tactical marketing activity as part of an overall plan that depends on deep functional expertise and is aligned to the demand funnel."
  />

  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-8">
    <div class="overflow-x-auto rounded-2xl border border-line bg-ink-raised">
      <table class="w-full min-w-[46rem] text-left text-sm">
        <thead>
          <tr>
            <th class="p-4"><span class="sr-only">Activity group</span></th>
            {
              funnelStages.map((s, i) => (
                <th class="p-4">
                  <span class="block font-mono text-xs font-normal text-accent">{String(i + 1).padStart(2, '0')}</span>
                  <span class="mt-1 block font-display text-base font-semibold">{s}</span>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            activities.map((row) => (
              <tr>
                <th scope="row" class={`${cell} font-display font-semibold`}>{row.group}</th>
                {row.stages.map((items) => (
                  <td class={cell}>
                    <ul class="space-y-1.5 text-muted">{items.map((i) => <li>{i}</li>)}</ul>
                  </td>
                ))}
              </tr>
            ))
          }
          <tr>
            <th scope="row" class={`${cell} font-display font-semibold`}>Strategy</th>
            <td colspan="4" class={`${cell} text-muted`}>{strategy}</td>
          </tr>
          <tr class="bg-panel">
            <th scope="row" class={`${cell} font-display font-semibold`}>Metrics</th>
            {
              metrics.map((items) => (
                <td class={cell}>
                  <ul class="space-y-1.5 font-mono text-xs text-subtle">{items.map((i) => <li>{i}</li>)}</ul>
                </td>
              ))
            }
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <Contact />
</BaseLayout>
