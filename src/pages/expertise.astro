---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Contact from '../components/Contact.astro';
import { expertise } from '../data/site';
---

<BaseLayout title="Expertise" description="Functional B2B marketing expertise from strategy and product to demand generation and enablement.">
  <PageHeader
    title="Expertise"
    label="Functional expertise"
    intro="Executing the most effective activities requires deep functional marketing expertise."
  />

  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-8">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        expertise.map((e, i) => (
          <li class="flex flex-col rounded-2xl border border-line bg-panel p-7">
            <p class="font-mono text-xs text-accent">{String(i + 1).padStart(2, '0')}</p>
            <h2 class="mt-3 font-display text-xl font-semibold">{e.area}</h2>
            <ul class="mt-4 space-y-2 text-[15px] text-muted">
              {e.items.map((item) => <li>{item}</li>)}
            </ul>
            {e.note && <p class="mt-5 border-t border-line pt-4 text-sm leading-relaxed text-subtle">{e.note}</p>}
          </li>
        ))
      }
    </ul>
  </section>

  <Contact />
</BaseLayout>
