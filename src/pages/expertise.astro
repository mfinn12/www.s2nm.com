---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Contact from '../components/Contact.astro';
import { expertise } from '../data/site';
---

<BaseLayout title="Expertise" description="Functional B2B marketing expertise from strategy and product to demand generation and enablement.">
  <PageHeader title="Expertise" intro="Executing the most effective activities requires deep functional marketing expertise." />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        expertise.map((e) => (
          <li class="rounded-xl border border-slate-200 p-6 dark:border-slate-800">
            <h2 class="font-display text-lg font-semibold text-brand dark:text-brand-soft">{e.area}</h2>
            <ul class="mt-3 space-y-1 text-slate-700 dark:text-slate-300">
              {e.items.map((i) => <li>{i}</li>)}
            </ul>
            {e.note && <p class="mt-3 text-sm text-slate-500 italic">{e.note}</p>}
          </li>
        ))
      }
    </ul>
  </section>

  <Contact />
</BaseLayout>
